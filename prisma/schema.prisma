  updatedBy       String?

  ente            EntePublico @relation(fields: [enteId], references: [id])
  alertas         AlertaCronograma[]

  @@unique([enteId, fecha])
  @@unique([enteId, fechaRecurrente])
  @@index([enteId, activo])
  @@map("tb_dia_no_laborable_ente")
}

model AlertaCronograma {
  id                String                 @id @default(uuid())
  cronogramaId      String                 @map("id_cronograma")
  diaNoLaborableId  String                 @map("id_dia_no_laborable")
  campoAfectado     String                 @map("campo_afectado") @db.VarChar(100)
  fechaConflicto    DateTime               @map("fec_conflicto")
  resuelta          Boolean                @default(false) @map("ind_resuelta")
  resueltaPor       String?                @map("resuelta_por")
  resueltaEn        DateTime?              @map("fec_resuelta")
  createdAt         DateTime               @default(now())

  cronograma        CronogramaExpediente   @relation(fields: [cronogramaId], references: [id], onDelete: Cascade)
  diaNoLaborable    DiaNoLaborableEnte     @relation(fields: [diaNoLaborableId], references: [id])

  @@index([cronogramaId, resuelta])
  @@index([diaNoLaborableId])
  @@map("tb_alerta_cronograma")
}
