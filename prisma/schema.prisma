// Tabla 19 — Resultado raíz de evaluación por oferente (Fase 3)
model EvaluacionResultados {
  id       String @id @default(uuid())
  ofertaId String @unique

  // Datos copiados del oferente al momento de evaluar
  nombreProveedorEvaluado String @map("nombre_proveedor_evaluado_au_au") @db.VarChar(255)
  rifProveedorEvaluado    String @map("rif_proveedor_evaluado_au_au") @db.VarChar(20)
  nombreRepLegalEvaluado  String @map("nombre_rep_legal_evaluado_au_au") @db.VarChar(255)
  cedulaRepLegalEvaluado  String @map("cedula_rep_legal_evaluado_au_au") @db.VarChar(20)

  // Calificación del oferente
  oferenteCalificado    Boolean? @map("oferente_calificado_au_au")
  motivoDescalificacion String?  @map("motivo_descalificacion_oferente_au_au")

  // Posición de prelación (texto: "Primera Opción", etc.)
  posicionPrelacion String? @map("posicion_prelacion_au_au") @db.VarChar(50)

  // Totales calculados
  totalTecnica    Decimal? @map("total_tecnica_au_au") @db.Decimal(5, 2)
  totalEconomica  Decimal? @map("total_economica_au_au") @db.Decimal(5, 2)
  totalVan        Decimal? @map("total_van_au_au") @db.Decimal(5, 2)
  totalEvaluacion Decimal? @map("total_evaluacion_oferente_au_au") @db.Decimal(6, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  oferta              OfertaPresentada    @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  sobre1              Sobre1?
  sobre2              Sobre2?
  documentosGenerados DocumentoGenerado[]

  @@index([ofertaId])
  @@map("tb_evaluacion_resultados")
}

