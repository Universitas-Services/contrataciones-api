# ==============================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================
PORT=3000
NODE_ENV=development

# ==============================================
# BASE DE DATOS - PostgreSQL
# ==============================================
DATABASE_URL="postgresql://nestjs_user:nestjs_password_2024@127.0.0.1:5434/contrataciones_db?schema=public"

# ==============================================
# AUTENTICACIÓN - JWT
# ==============================================
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_EXPIRATION=24h

# ==============================================
# CORS - Frontend URL
# ==============================================
FRONTEND_URL=http://localhost:3000

# ==============================================
# ARCHIVO DE CONFIGURACIÓN
# ==============================================
# Copia este archivo a .env y ajusta los valores según tu entorno

# ==============================================
# EMAIL - Resend API
# ==============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
FROM_EMAIL=no-reply@tudominio.com

# Agente de compliance (docs/API_DICTAMEN_NEST.md). La clave se pide al equipo del agente
# por un canal seguro: nunca en el repositorio. Sin URL o sin clave, la cola no procesa.
COMPLIANCE_AGENT_URL=https://compliance-contrataciones-26265028623.us-east4.run.app
COMPLIANCE_AGENT_KEY=
# Tamaño máximo por archivo. Cloudinary gratis admite 10 MB; el agente, hasta 30.
COMPLIANCE_MAX_MB=10
# Análisis simultáneos. 4 en Render gratis (512 MB); hasta 60 en un servidor mayor.
COMPLIANCE_CONCURRENCIA=4
